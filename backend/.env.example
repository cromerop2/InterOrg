# Formato: postgresql+pg8000://USUARIO:PASSWORD@HOST:5432/BASE_DE_DATOS
DATABASE_URL=postgresql+pg8000://TU_USUARIO:TU_PASSWORD@TU_HOST_POSTGRES:5432/TU_DATABASE
# Genera una clave larga y aleatoria:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia_esta_clave_por_una_larga_y_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
